   C(N1) = '1';
   DO N2 = (N1 + 1) TO CONFIG_SIZE;
   IF C(N2) ^= '-' THEN GO TO LVL6_N2;
   C(N2) = '2';
   DO N3 = (N2 + 1) TO CONFIG_SIZE;
   IF C(N3) ^= '-' THEN GO TO LVL6_N3;
   C(N3) = '3';
   DO N4 = (N3 + 1) TO CONFIG_SIZE;
   IF C(N4) ^= '-' THEN GO TO LVL6_N4;
   C(N4) = '4';
   DO N5 = (N4 + 1) TO CONFIG_SIZE;
   IF C(N5) ^= '-' THEN GO TO LVL6_N5;
   C(N5) = '5';
   DO N6 = (N5 + 1) TO CONFIG_SIZE;
   IF C(N6) ^= '-' THEN GO TO LVL6_N6;
   C(N6) = '6';
   CALL CHECK_CONFIG;
   C(N6) = '-'; LVL6_N6: END;
   C(N5) = '-'; LVL6_N5: END;
   C(N4) = '-'; LVL6_N4: END;
   C(N3) = '-'; LVL6_N3: END;
   C(N2) = '-'; LVL6_N2: END;
   C(N1) = '-'; LVL6_N1: END;
   C(Z)  = '-'; LP3_LVL6_Z:  END;
   C(Y)  = '-'; LP3_LVL6_Y:  END;

 LEVEL = 7;

 IF NUMBER_PIECES_BEG <= 7 & NUMBER_PIECES_END >= 7 THEN
   DO Y = 2 TO CONFIG_SIZE;
   IF Y = CONFIG_CENTER | C(Y) ^= '-' THEN GO TO LP3_LVL7_Y;
   C(Y) = 'Y';
   DO Z = 3 TO CONFIG_SIZE;
   IF Z = CONFIG_CENTER | C(Z) ^= '-' THEN GO TO LP3_LVL7_Z;
   C(Z) = 'Z';
   DO N1 = 1 TO CONFIG_SIZE;
   IF C(N1) ^= '-' THEN GO TO LVL7_N1;
   C(N1) = '1';
   DO N2 = (N1 + 1) TO CONFIG_SIZE;
   IF C(N2) ^= '-' THEN GO TO LVL7_N2;
   C(N2) = '2';
   DO N3 = (N2 + 1) TO CONFIG_SIZE;
   IF C(N3) ^= '-' THEN GO TO LVL7_N3;
   C(N3) = '3';
   DO N4 = (N3 + 1) TO CONFIG_SIZE;
   IF C(N4) ^= '-' THEN GO TO LVL7_N4;
   C(N4) = '4';
   DO N5 = (N4 + 1) TO CONFIG_SIZE;
   IF C(N5) ^= '-' THEN GO TO LVL7_N5;
   C(N5) = '5';
   DO N6 = (N5 + 1) TO CONFIG_SIZE;
   IF C(N6) ^= '-' THEN GO TO LVL7_N6;
   C(N6) = '6';
   DO N7 = (N6 + 1) TO CONFIG_SIZE;
   IF C(N7) ^= '-' THEN GO TO LVL7_N7;
   C(N7) = '7';
   CALL CHECK_CONFIG;
   C(N7) = '-'; LVL7_N7: END;
   C(N6) = '-'; LVL7_N6: END;
   C(N5) = '-'; LVL7_N5: END;
   C(N4) = '-'; LVL7_N4: END;
   C(N3) = '-'; LVL7_N3: END;
   C(N2) = '-'; LVL7_N2: END;
   C(N1) = '-'; LVL7_N1: END;
   C(Z)  = '-'; LP3_LVL7_Z:  END;
   C(Y)  = '-'; LP3_LVL7_Y:  END;

 LEVEL = 8;

 IF NUMBER_PIECES_BEG <= 8 & NUMBER_PIECES_END >= 8 THEN
   DO Y = 2 TO CONFIG_SIZE;
   IF Y = CONFIG_CENTER | C(Y) ^= '-' THEN GO TO LP3_LVL8_Y;
   C(Y) = 'Y';
   DO Z = 3 TO CONFIG_SIZE;
   IF Z = CONFIG_CENTER | C(Z) ^= '-' THEN GO TO LP3_LVL8_Z;
   C(Z) = 'Z';
   DO N1 = 1 TO CONFIG_SIZE;
   IF C(N1) ^= '-' THEN GO TO LVL8_N1;
   C(N1) = '1';
   DO N2 = (N1 + 1) TO CONFIG_SIZE;
   IF C(N2) ^= '-' THEN GO TO LVL8_N2;
   C(N2) = '2';
   DO N3 = (N2 + 1) TO CONFIG_SIZE;
   IF C(N3) ^= '-' THEN GO TO LVL8_N3;
   C(N3) = '3';
   DO N4 = (N3 + 1) TO CONFIG_SIZE;
   IF C(N4) ^= '-' THEN GO TO LVL8_N4;
   C(N4) = '4';
   DO N5 = (N4 + 1) TO CONFIG_SIZE;
   IF C(N5) ^= '-' THEN GO TO LVL8_N5;
   C(N5) = '5';
   DO N6 = (N5 + 1) TO CONFIG_SIZE;
   IF C(N6) ^= '-' THEN GO TO LVL8_N6;
   C(N6) = '6';
   DO N7 = (N6 + 1) TO CONFIG_SIZE;
   IF C(N7) ^= '-' THEN GO TO LVL8_N7;
   C(N7) = '7';
   DO N8 = (N7 + 1) TO CONFIG_SIZE;
   IF C(N8) ^= '-' THEN GO TO LVL8_N8;
   C(N8) = '8';
   CALL CHECK_CONFIG;
   C(N8) = '-'; LVL8_N8: END;
   C(N7) = '-'; LVL8_N7: END;
   C(N6) = '-'; LVL8_N6: END;
   C(N5) = '-'; LVL8_N5: END;
   C(N4) = '-'; LVL8_N4: END;
   C(N3) = '-'; LVL8_N3: END;
   C(N2) = '-'; LVL8_N2: END;
   C(N1) = '-'; LVL8_N1: END;
   C(Z)  = '-'; LP3_LVL8_Z:  END;
   C(Y)  = '-'; LP3_LVL8_Y:  END;

 LEVEL = 9;

 IF NUMBER_PIECES_BEG >= 9 THEN
   DO Y = 2 TO CONFIG_SIZE;
   IF Y = CONFIG_CENTER | C(Y) ^= '-' THEN GO TO LP3_LVL9_Y;
   C(Y) = 'Y';
   DO Z = 3 TO CONFIG_SIZE;
   IF Z = CONFIG_CENTER | C(Z) ^= '-' THEN GO TO LP3_LVL9_Z;
   C(Z) = 'Z';
   DO N1 = 1 TO CONFIG_SIZE;
   IF C(N1) ^= '-' THEN GO TO LVL9_N1;
   C(N1) = '1';
   DO N2 = (N1 + 1) TO CONFIG_SIZE;
   IF C(N2) ^= '-' THEN GO TO LVL9_N2;
   C(N2) = '2';
   DO N3 = (N2 + 1) TO CONFIG_SIZE;
   IF C(N3) ^= '-' THEN GO TO LVL9_N3;
   C(N3) = '3';
   DO N4 = (N3 + 1) TO CONFIG_SIZE;
   IF C(N4) ^= '-' THEN GO TO LVL9_N4;
   C(N4) = '4';
   DO N5 = (N4 + 1) TO CONFIG_SIZE;
   IF C(N5) ^= '-' THEN GO TO LVL9_N5;
   C(N5) = '5';
   DO N6 = (N5 + 1) TO CONFIG_SIZE;
   IF C(N6) ^= '-' THEN GO TO LVL9_N6;
   C(N6) = '6';
   DO N7 = (N6 + 1) TO CONFIG_SIZE;
   IF C(N7) ^= '-' THEN GO TO LVL9_N7;
   C(N7) = '7';
   DO N8 = (N7 + 1) TO CONFIG_SIZE;
   IF C(N8) ^= '-' THEN GO TO LVL9_N8;
   C(N8) = '8';
   DO N9 = (N8 + 1) TO CONFIG_SIZE;
   IF C(N9) ^= '-' THEN GO TO LVL9_N9;
   C(N9) = '9';
   CALL CHECK_CONFIG;
   C(N9) = '-'; LVL9_N9: END;
   C(N8) = '-'; LVL9_N8: END;
   C(N7) = '-'; LVL9_N7: END;
   C(N6) = '-'; LVL9_N6: END;
   C(N5) = '-'; LVL9_N5: END;
   C(N4) = '-'; LVL9_N4: END;
   C(N3) = '-'; LVL9_N3: END;
   C(N2) = '-'; LVL9_N2: END;
   C(N1) = '-'; LVL9_N1: END;
   C(Z)  = '-'; LP3_LVL9_Z:  END;
   C(Y)  = '-'; LP3_LVL9_Y:  END;

 END LETTER_PIECES_3;

 CALL WRAP_UP;

 /*---------------------*/
 /* Check configuration */
 /*---------------------*/

 CHECK_CONFIG: PROC;

 DCL I                        FIXED BIN (31) INIT (0);

 DCL (ROW,COL)                FIXED BIN (31) INIT (0);

 DCL CUR_POS                  FIXED BIN (31) INIT (0);

 DCL LETTER_PIECES            FIXED BIN (31) AUTO INIT (0);
 DCL LETTER_PIECES_CHECKED    FIXED BIN (31) AUTO INIT (0);

 CONFIGURATIONS = CONFIGURATIONS + 1;

 /*--------------------------------------*/
 /* +----+----+----+----+----+----+----+ */
 /* | 11 | 12 | 13 | 14 | 15 | 16 | 17 | */
 /* | 01 | 02 | 03 | 04 | 05 | 06 | 07 | */
 /* | 01 | 02 | 03 | 04 | 05 | 06 | 07 | */
 /* +----+----+----+----+----+----+----+ */
 /* | 21 | 22 | 23 | 24 | 25 | 26 | 27 | */
 /* | 08 | 09 | 10 | 11 | 12 | 13 | 14 | */
 /* | 08 | 09 | 0A | 0B | 0C | 0D | 0E | */
 /* +----+----+----+----+----+----+----+ */
 /* | 31 | 32 | 33 | 34 | 35 | 36 | 37 | */
 /* | 15 | 16 | 17 | 18 | 19 | 20 | 21 | */
 /* | 0F | 10 | 11 | 12 | 13 | 14 | 15 | */
 /* +----+----+----+----+----+----+----+ */
 /* | 41 | 42 | 43 | 44 | 45 | 46 | 47 | */
 /* | 22 | 23 | 24 | 25 | 26 | 27 | 28 | */
 /* | 16 | 17 | 18 | 19 | 1A | 1B | 1C | */
 /* +----+----+----+----+----+----+----+ */
 /* | 51 | 52 | 53 | 54 | 55 | 56 | 57 | */
 /* | 29 | 30 | 31 | 32 | 33 | 34 | 35 | */
 /* | 1D | 1E | 1F | 20 | 21 | 22 | 23 | */
 /* +----+----+----+----+----+----+----+ */
 /* | 58 | 59 | 60 | 61 | 62 | 63 | 64 | */
 /* | 36 | 37 | 38 | 39 | 40 | 41 | 42 | */
 /* | 24 | 25 | 26 | 27 | 28 | 29 | 2A | */
 /* +----+----+----+----+----+----+----+ */
 /* | 65 | 66 | 67 | 68 | 69 | 70 | 71 | */
 /* | 43 | 44 | 45 | 46 | 47 | 48 | 49 | */
 /* | 2B | 2C | 2D | 2E | 2F | 30 | 31 | */
 /* +----+----+----+----+----+----+----+ */
 /*--------------------------------------*/

 IF DEBUGGING THEN
   PUT FILE (STATS) EDIT
     (SUBSTR(CONFIG,01,7), X, Y, Z, N1, N2, N3, N4, N5, N6, N7, N8, N9,
      SUBSTR(CONFIG,08,7),
      SUBSTR(CONFIG,15,7),
      SUBSTR(CONFIG,22,7),
      SUBSTR(CONFIG,29,7),
      SUBSTR(CONFIG,26,7),
      SUBSTR(CONFIG,43,7))
     (SKIP, A, 12 (P'Z99'), 6 (SKIP, A));

 SUBSTR(BOARD,11,7) = SUBSTR(CONFIG,01,7);
 SUBSTR(BOARD,21,7) = SUBSTR(CONFIG,08,7);
 SUBSTR(BOARD,31,7) = SUBSTR(CONFIG,15,7);
 SUBSTR(BOARD,41,7) = SUBSTR(CONFIG,22,7);
 SUBSTR(BOARD,51,7) = SUBSTR(CONFIG,29,7);
 SUBSTR(BOARD,61,7) = SUBSTR(CONFIG,36,7);
 SUBSTR(BOARD,71,7) = SUBSTR(CONFIG,43,7);

 DO I = BOARD_BEGIN TO BOARD_SIZE;
   IF B(I) >= 'X' & B(I) <= 'Z' THEN DO;
     LETTER_PIECES = LETTER_PIECES + 1;
     B(I) = 'L';
   END;
   ELSE
     IF B(I) >= '1' & B(I) <= '9' THEN
       B(I) = 'N';
 END;

 /*----------------------------------*/
 /* Check for stranded letter pieces */
 /*----------------------------------*/

 /*---------------------------------*/
 /* L - Letter Piece                */
 /* N - Number Piece                */
 /* v - Vacant                      */
 /* a - Vacant                      */
 /* b - Vacant                      */
 /* c - Vacant                      */
 /* - - Vacant but Not Significant  */
 /*---------------------------------*/

 /*-------------------------------*/
 /*  a+b  |  a+b  |  a+b  |  a+b  */
 /*  a+c  |  a+c  |  a+c  |  a+c  */
 /*-------------------------------*/
 /* bbacc | --bbb | ----- | bbb-- */
 /* bbacc | --bbb | ----- | bbb-- */
 /* bb-cc | ---aa | bb-cc | aa--- */
 /* ----- | --ccc | bbacc | ccc-- */
 /* ----- | --ccc | bbacc | ccc-- */
 /*-------------------------------*/

 /*---------------------------------------*/
 /*   a+b   |   a+b   |   a+b   |   a+b   */
 /*   a+c   |   a+c   |   a+c   |   a+c   */
 /*---------------------------------------*/
 /* bbbaccc | ---bbbb | ------- | bbbb--- */
 /* bbbaccc | ---bbbb | ------- | bbbb--- */
 /* bbbaccc | ---bbbb | ------- | bbbb--- */
 /* bbb-ccc | ----aaa | bbb-ccc | aaa---- */
 /* ------- | ---cccc | bbbaccc | cccc--- */
 /* ------- | ---cccc | bbbaccc | cccc--- */
 /* ------- | ---cccc | bbbaccc | cccc--- */
 /*---------------------------------------*/
 /*
 IF (B(14) = '-' & B(24) = '-' & B(25) = '-') THEN
   IF ( B(11) = '-' & B(12) = '-' & B(13) = '-'
      & B(21) = '-' & B(22) = '-' & B(23) = '-'
      & B(31) = '-' & B(32) = '-' & B(33) = '-')
    | ( B(16) = '-' & B(17) = '-' & B(18) = '-'
      & B(26) = '-' & B(27) = '-' & B(28) = '-'
      & B(36) = '-' & B(37) = '-' & B(38) = '-') THEN GO TO STRANDED_POSITION;

 IF (B(34) = '-' & B(35) = '-') THEN
   IF ( B(13) = '-' & B(14) = '-' & B(14) = '-'
      & B(15) = '-' & B(23) = '-' & B(23) = '-'
      & B(24) = '-' & B(25) = '-' & B(25) = '-' )
    | ( B(43) = '-' & B(44) = '-' & B(44) = '-'
      & B(45) = '-' & B(53) = '-' & B(53) = '-'
      & B(54) = '-' & B(55) = '-' & B(55) = '-' )TRANDED_POSITION;

 IF (B(43) = '-' & B(53) = '-') THEN
   IF ( B(31) = '-' & B(32) = '-'
      & B(41) = '-' & B(42) = '-'
      & B(51) = '-' & B(52) = '-' )
    | ( B(34) = '-' & B(35) = '-'
      & B(44) = '-' & B(45) = '-'
      & B(54) = '-' & B(55) = '-' ) THEN GO TO STRANDED_POSITION;

 IF (B(31) = '-' & B(32) = '-') THEN
   IF ( B(11) = '-' & B(12) = '-'
      & B(13) = '-' & B(21) = '-'
      & B(22) = '-' & B(23) = '-' )
    | ( B(41) = '-' & B(42) = '-'
      & B(43) = '-' & B(51) = '-'
      & B(52) = '-' & B(53) = '-' ) THEN GO TO STRANDED_POSITION;
 */
 /*-------------------------------*/
 /* L-vvv | vvv-L | v---- | ----v */
 /* ----- | ----- | v---- | ----v */
 /* v---- | ----v | v---- | ----v */
 /* v---- | ----v | ----- | ----- */
 /* v---- | ----v | L-vvv | vvv-L */
 /*-------------------------------*/

 IF B(11) = 'L' THEN DO;
   IF B(13) = '-' & B(14) = '-' & B(15) = '-'
    & B(31) = '-' & B(41) = '-' & B(51) = '-' THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 IF B(15) = 'L' THEN DO;
   IF B(11) = '-' & B(12) = '-' & B(13) = '-'
    & B(35) = '-' & B(45) = '-' & B(55) = '-' THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 IF B(51) = 'L' THEN DO;
   IF B(11) = '-' & B(21) = '-' & B(31) = '-'
    & B(53) = '-' & B(54) = '-' & B(55) = '-' THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 IF B(55) = 'L' THEN DO;
   IF B(15) = '-' & B(25) = '-' & B(35) = '-'
    & B(51) = '-' & B(52) = '-' & B(53) = '-' THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 /*---------------------------------------------------------------*/
 /* -L-vv | vv-L- | --vvv | vvv-- | v---- | ----v | vv--- | ---vv */
 /* ----- | ----- | L-vvv | vvv-L | v---- | ----v | vv--- | ---vv */
 /* vv--- | ---vv | ----- | ----- | ----- | ----- | vv--- | ---vv */
 /* vv--- | ---vv | v---- | ----v | L-vvv | vvv-L | ----- | ----- */
 /* vv--- | ---vv | v---- | ----v | --vvv | vvv-- | -L-vv | vv-L- */
 /*---------------------------------------------------------------*/

 IF B(12) = 'L' THEN DO;
   IF B(14) = '-' & B(15) = '-'
    & B(31) = '-' & B(32) = '-'
    & B(41) = '-' & B(42) = '-'
    & B(51) = '-' & B(52) = '-' THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 IF B(14) = 'L' THEN DO;
   IF B(11) = '-' & B(12) = '-'
    & B(34) = '-' & B(35) = '-'
    & B(44) = '-' & B(45) = '-'
    & B(54) = '-' & B(55) = '-' THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 IF B(21) = 'L' THEN DO;
   IF B(13) = '-' & B(14) = '-'
    & B(15) = '-' & B(23) = '-'
    & B(24) = '-' & B(25) = '-'
    & B(41) = '-' & B(51) = '-' THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 IF B(25) = 'L' THEN DO;
   IF B(11) = '-' & B(12) = '-'
    & B(13) = '-' & B(21) = '-'
    & B(22) = '-' & B(23) = '-'
    & B(45) = '-' & B(55) = '-' THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 IF B(41) = 'L' THEN DO;
   IF B(11) = '-' & B(21) = '-'
    & B(43) = '-' & B(44) = '-'
    & B(45) = '-' & B(53) = '-'
    & B(54) = '-' & B(55) = '-' THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 IF B(45) = 'L' THEN DO;
   IF B(15) = '-' & B(25) = '-'
    & B(41) = '-' & B(42) = '-'
    & B(43) = '-' & B(51) = '-'
    & B(52) = '-' & B(53) = '-' THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 IF B(52) = 'L' THEN DO;
   IF B(11) = '-' & B(12) = '-'
    & B(21) = '-' & B(22) = '-'
    & B(31) = '-' & B(32) = '-'
    & B(54) = '-' & B(55) = '-' THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 IF B(54) = 'L' THEN DO;
   IF B(14) = '-' & B(15) = '-'
    & B(24) = '-' & B(25) = '-'
    & B(34) = '-' & B(35) = '-'
    & B(51) = '-' & B(52) = '-' THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 /*-------------------------------*/
 /* ---vv | ---vv | vv--- | vv--- */
 /* -L-vv | ---vv | vv-L- | vv--- */
 /* ----- | ----- | ----- | ----- */
 /* vv--- | vv-L- | ---vv | -L-vv */
 /* vv--- | vv--- | ---vv | ---vv */
 /*-------------------------------*/

 IF B(22) = 'L' | B(44) = 'L' THEN DO;
   IF B(14) = '-' & B(15) = '-'
    & B(24) = '-' & B(25) = '-'
    & B(41) = '-' & B(42) = '-'
    & B(51) = '-' & B(52) = '-' THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 IF B(24) = 'L' | B(42) = 'L' THEN DO;
   IF B(11) = '-' & B(12) = '-'
    & B(21) = '-' & B(22) = '-'
    & B(44) = '-' & B(45) = '-'
    & B(54) = '-' & B(55) = '-' THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 /*-------------------------------*/
 /* L+a+b | L+a+b | L+a+b | L+a+b */
 /* L+a+c | L+a+c | L+a+c | L+a+c */
 /*-------------------------------*/
 /* a---a | aa-cc | bbacc | cc-aa */
 /* a-L-a | ---cc | bbacc | cc--- */
 /* ----- | -L-aa | ----- | aa-L- */
 /* bbacc | ---bb | a-L-a | bb--- */
 /* bbacc | aa-bb | a---a | bb-aa */
 /*-------------------------------*/

 IF B(23) = 'L' THEN DO;
   IF B(11) = '-' & B(15) = '-'
    & B(21) = '-' & B(25) = '-'
    & B(43) = '-' & B(53) = '-' THEN
     IF ( B(41) = '-' & B(42) = '-'
        & B(51) = '-' & B(52) = '-' )
      | ( B(44) = '-' & B(45) = '-'
        & B(54) = '-' & B(55) = '-' ) THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 IF B(32) = 'L' THEN DO;
   IF B(11) = '-' & B(12) = '-'
    & B(34) = '-' & B(35) = '-'
    & B(51) = '-' & B(52) = '-' THEN
     IF ( B(14) = '-' & B(15) = '-'
        & B(24) = '-' & B(25) = '-' )
      | ( B(44) = '-' & B(45) = '-'
        & B(54) = '-' & B(55) = '-' ) THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 IF B(43) = 'L' THEN DO;
   IF B(13) = '-' & B(23) = '-'
    & B(41) = '-' & B(45) = '-'
    & B(51) = '-' & B(55) = '-' THEN
     IF ( B(11) = '-' & B(12) = '-'
        & B(21) = '-' & B(22) = '-' )
      | ( B(14) = '-' & B(15) = '-'
        & B(24) = '-' & B(25) = '-' ) THEN GO TO STRANDED_POSITION;

   LETTER_PIECES_CHECKED = LETTER_PIECES_CHECKED + 1;

   IF LETTER_PIECES_CHECKED = LETTER_PIECES THEN GO TO STRANDED_CHECK_COMPLETE;
 END;

 IF B(34) = 'L' THEN
   IF B(14) = '-' & B(15) = '-'
    & B(31) = '-' & B(32) = '-'
    & B(54) = '-' & B(55) = '-' THEN
     IF ( B(41) = '-' & B(42) = '-'
        & B(51) = '-' & B(52) = '-' )
      | ( B(11) = '-' & B(12) = '-'
        & B(21) = '-' & B(22) = '-' ) THEN GO TO STRANDED_POSITION;

 GO TO STRANDED_CHECK_COMPLETE;

 /*-------------------------------------------------*/
 /* It's not possible for the letter pieces to exit */
 /*-------------------------------------------------*/

 STRANDED_POSITION:

 STRANDED = STRANDED + 1;

 IF DEBUGGING THEN
   PUT FILE (STATS) EDIT (' - Stranded') (A);

 RETURN;

 STRANDED_CHECK_COMPLETE:

 /*--------------------------------------*/
 /* Check for at least one possible move */
 /*--------------------------------------*/

 DO ROW = 1 TO 5;
   DO COL = 1 TO 5;
     CUR_POS = ROW * 10 + COL;
     IF B(CUR_POS) ^= '-' THEN
       SELECT (ROW);
         /*-------*/
         /* Row 1 */
         /*-------*/
         WHEN (1) DO;
           SELECT (COL);
             /*------------------*/
             /* Row 1 - Column 1 */
             /*------------------*/
             WHEN (1) DO;
               IF B(12) = '-' THEN
                 IF B(13) ^= '-' | B(14) ^= '-' | B(15) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(21) = '-' THEN
                 IF B(31) ^= '-' | B(41) ^= '-' | B(51) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 1 - Column 2 */
             /*------------------*/
             WHEN (2) DO;
               IF B(13) = '-' THEN
                 IF B(14) ^= '-' | B(15) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(22) = '-' THEN
                 IF B(32) ^= '-' | B(42) ^= '-' | B(52) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 1 - Column 3 */
             /*------------------*/
             WHEN (3) DO;
               IF B(12) = '-' & B(11) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
               IF B(14) = '-' & B(15) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
               IF B(23) = '-' THEN
                 IF B(33) ^= '-' | B(43) ^= '-' | B(53) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 1 - Column 4 */
             /*------------------*/
             WHEN (4) DO;
               IF B(13) = '-' THEN
                 IF B(12) ^= '-' | B(11) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(24) = '-' THEN
                 IF B(34) ^= '-' | B(44) ^= '-' | B(54) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 1 - Column 5 */
             /*------------------*/
             WHEN (5) DO;
               IF B(14) = '-' THEN
                 IF B(13) ^= '-' | B(12) ^= '-' | B(11) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(25) = '-' THEN
                 IF B(35) ^= '-' | B(45) ^= '-' | B(55) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             OTHERWISE;
           END;
         END;
         /*-------*/
         /* Row 2 */
         /*-------*/
         WHEN (2) DO;
           SELECT (COL);
             /*------------------*/
             /* Row 2 - Column 1 */
             /*------------------*/
             WHEN (1) DO;
               IF B(22) = '-' THEN
                 IF B(23) ^= '-' | B(24) ^= '-' | B(25) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(31) = '-' THEN
                 IF B(41) ^= '-' | B(51) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 2 - Column 2 */
             /*------------------*/
             WHEN (2) DO;
               IF B(23) = '-' THEN
                 IF B(24) ^= '-' | B(25) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(32) = '-' THEN
                 IF B(42) ^= '-' | B(52) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 2 - Column 3 */
             /*------------------*/
             WHEN (3) DO;
               IF B(22) = '-' & B(21) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
               IF B(24) = '-' & B(25) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
               IF B(33) = '-' THEN
                 IF B(43) ^= '-' | B(53) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 2 - Column 4 */
             /*------------------*/
             WHEN (4) DO;
               IF B(23) = '-' THEN
                 IF B(22) ^= '-' | B(21) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(34) = '-' THEN
                 IF B(44) ^= '-' | B(54) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 2 - Column 5 */
             /*------------------*/
             WHEN (5) DO;
               IF B(24) = '-' THEN
                 IF B(23) ^= '-' | B(22) ^= '-' | B(21) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(35) = '-' THEN
                 IF B(45) ^= '-' | B(55) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             OTHERWISE;
           END;
         END;
         /*-------*/
         /* Row 3 */
         /*-------*/
         WHEN (3) DO;
           SELECT (COL);
             /*------------------*/
             /* Row 3 - Column 1 */
             /*------------------*/
             WHEN (1) DO;
               IF B(32) = '-' THEN
                 IF B(33) ^= '-' | B(34) ^= '-' | B(35) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(21) = '-' & B(11) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
               IF B(41) = '-' & B(51) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 3 - Column 2 */
             /*------------------*/
             WHEN (2) DO;
               IF B(33) = '-' THEN
                 IF B(34) ^= '-' | B(35) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(22) = '-' & B(12) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
               IF B(42) = '-' & B(52) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 3 - Column 4 */
             /*------------------*/
             WHEN (3) DO;
               IF B(32) = '-' & B(31) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
               IF B(34) = '-' & B(35) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
               IF B(23) = '-' & B(13) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
               IF B(43) = '-' & B(53) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 3 - Column 4 */
             /*------------------*/
             WHEN (4) DO;
               IF B(33) = '-' THEN
                 IF B(32) ^= '-' | B(31) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(24) = '-' & B(14) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
               IF B(44) = '-' & B(54) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 3 - Column 5 */
             /*------------------*/
             WHEN (5) DO;
               IF B(34) = '-' THEN
                 IF B(33) ^= '-' | B(32) ^= '-' | B(31) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(25) = '-' & B(15) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
               IF B(45) = '-' & B(55) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
             END;
             OTHERWISE;
           END;
         END;
         /*-------*/
         /* Row 4 */
         /*-------*/
         WHEN (4) DO;
           SELECT (COL);
             /*------------------*/
             /* Row 4 - Column 1 */
             /*------------------*/
             WHEN (1) DO;
               IF B(42) = '-' THEN
                 IF B(43) ^= '-' | B(44) ^= '-' | B(45) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(31) = '-' THEN
                 IF B(21) ^= '-' | B(11) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 4 - Column 2 */
             /*------------------*/
             WHEN (2) DO;
               IF B(43) = '-' THEN
                 IF B(44) ^= '-' | B(45) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(32) = '-' THEN
                 IF B(22) ^= '-' | B(12) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 4 - Column 3 */
             /*------------------*/
             WHEN (3) DO;
               IF B(42) = '-' & B(41) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
               IF B(44) = '-' & B(45) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
               IF B(33) = '-' THEN
                 IF B(23) ^= '-' | B(13) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 4 - Column 4 */
             /*------------------*/
             WHEN (4) DO;
               IF B(43) = '-' THEN
                 IF B(42) ^= '-' | B(41) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(34) = '-' THEN
                 IF B(24) ^= '-' | B(14) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 4 - Column 5 */
             /*------------------*/
             WHEN (5) DO;
               IF B(44) = '-' THEN
                 IF B(43) ^= '-' | B(42) ^= '-' | B(41) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(35) = '-' THEN
                 IF B(25) ^= '-' | B(15) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             OTHERWISE;
           END;
         END;
         /*-------*/
         /* Row 5 */
         /*-------*/
         WHEN (5) DO;
           SELECT (COL);
             /*------------------*/
             /* Row 5 - Column 1 */
             /*------------------*/
             WHEN (1) DO;
               IF B(52) = '-' THEN
                 IF B(53) ^= '-' | B(54) ^= '-' | B(55) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;

               IF B(41) = '-' THEN
                 IF B(31) ^= '-' | B(21) ^= '-' | B(11) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 5 - Column 2 */
             /*------------------*/
             WHEN (2) DO;
               IF B(53) = '-' THEN
                 IF B(54) ^= '-' | B(55) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(42) = '-' THEN
                 IF B(32) ^= '-' | B(22) ^= '-' | B(12) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 5 - Column 3 */
             /*------------------*/
             WHEN (3) DO;
               IF B(52) = '-' & B(51) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
               IF B(54) = '-' & B(55) ^= '-' THEN
                 GO TO MOVE_POSSIBLE;
               IF B(43) = '-' THEN
                 IF B(33) ^= '-' | B(23) ^= '-' | B(13) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             /*------------------*/
             /* Row 5 - Column 4 */
             /*------------------*/
             WHEN (4) DO;
               IF B(53) = '-' THEN
                 IF B(52) ^= '-' | B(51) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(44) = '-' THEN
                 IF B(34) ^= '-' | B(24) ^= '-' | B(14) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END; /* Column 4 */
             /*------------------*/
             /* Row 5 - Column 5 */
             /*------------------*/
             WHEN (5) DO;
               IF B(54) = '-' THEN
                 IF B(53) ^= '-' | B(52) ^= '-' | B(51) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
               IF B(45) = '-' THEN
                 IF B(35) ^= '-' | B(25) ^= '-' | B(15) ^= '-' THEN
                   GO TO MOVE_POSSIBLE;
             END;
             OTHERWISE;
           END;
         END;
         OTHERWISE;
       END;
   END;
 END;

 NO_MOVES = NO_MOVES + 1;

 IF DEBUGGING THEN
   PUT FILE (STATS) EDIT (' - No moves') (A);

 RETURN;

 MOVE_POSSIBLE:

 IF ^ UNSEEN() THEN
   RETURN;

 IF WRITTEN = MAX_CONFIGURATIONS THEN DO;
   PUT FILE (STATS) SKIP EDIT
     (' ',
      'Maximum configurations (', NUMSTR(MAX_CONFIGURATIONS),
      ') exceeded - Terminating')
     (A, SKIP, 3 A);

   CALL WRAP_UP;
   STOP;
 END;

 WRITTEN = WRITTEN + 1;

 WRITE FILE (CFGTXT) FROM (CONFIG);

 END CHECK_CONFIG;

  /*-----------------------------------------------*/
 /* Try to find a version, including rotations or */
 /* reflections, of the board in history table    */
 /*-----------------------------------------------*/

 UNSEEN: PROC RETURNS(BIT (1));

 %DCL DEBUG_UNSEEN CHAR;

 %DEBUG_UNSEEN = 'N';

 DCL (I,J,K)                  FIXED BIN (31) INIT (0);

 DCL (LP_CNT,NP_CNT)          FIXED BIN (31) INIT (0);

 DCL SORTED                   BIT (1) INIT (FALSE);

 /*-------------------------*/
 /* Build history table key */
 /*-------------------------*/

 LP_CNT = 0;
 NP_CNT = 3;

 HIST_KEY = (12)'00'X;

 DO I = 1 TO CONFIG_SIZE;
   IF C(I) ^= '-' THEN
     IF C(I) >= 'X' & C(I) <= 'Z' THEN DO;
       LP_CNT = LP_CNT + 1;
       HK(LP_CNT) = I;
     END;
     ELSE DO;
       NP_CNT = NP_CNT + 1;
       HK(NP_CNT) = I;
     END;
 END;

 /*------------------------------------------*/
 /* Search for all rotations and reflections */
 /*------------------------------------------*/

 HIST_KEY_TBL(1) = HIST_KEY;

 HIST_KEY_TBL(2) = TRANSLATE(HIST_KEY_TBL(1), ROT_TABLE);
 HIST_KEY_TBL(3) = TRANSLATE(HIST_KEY_TBL(2), ROT_TABLE);
 HIST_KEY_TBL(4) = TRANSLATE(HIST_KEY_TBL(3), ROT_TABLE);
 HIST_KEY_TBL(5) = TRANSLATE(HIST_KEY_TBL(1), REF_TABLE);
 HIST_KEY_TBL(6) = TRANSLATE(HIST_KEY_TBL(2), REF_TABLE);
 HIST_KEY_TBL(7) = TRANSLATE(HIST_KEY_TBL(3), REF_TABLE);
 HIST_KEY_TBL(8) = TRANSLATE(HIST_KEY_TBL(4), REF_TABLE);

 DO I = 1 TO 8;
   HIST_KEY = HIST_KEY_TBL(I);

   /*------------------------------------------------------*/
   /* Sort the key because rotations and reflections cause */
   /* the board positions in the key to be out of order.   */
   /*------------------------------------------------------*/

   %IF DEBUG_UNSEEN = 'Y' %THEN %DO;
   PUT FILE (STATS) SKIP EDIT ('KEY ', HEX(HIST_KEY)) (2 A);
   %END;
   /*--------------------*/
   /* Sort letter pieces */
   /*--------------------*/

   IF LP_CNT > 1 THEN
     IF LP_CNT = 2 THEN
       IF HK(1) > HK(2) THEN DO;
         /*----*/
         /* 21 */
         /*----*/
         K     = HK(1);
         HK(1) = HK(2);
         HK(2) = K;
       END;
       ELSE;
     ELSE
       IF HK(1) > HK(2) THEN
         IF HK(1) > HK(3) THEN
           IF HK(2) > HK(3) THEN DO;
             /*-----*/
             /* 321 */
             /*-----*/
             K     = HK(1);
             HK(1) = HK(3);
             HK(3) = K;
           END;
           ELSE DO;
             /*-----*/
             /* 312 */
             /*-----*/
             K     = HK(1);
             HK(1) = HK(2);
             HK(2) = HK(3);
             HK(3) = K;
           END;
         ELSE DO;
           /*-----*/
           /* 213 */
           /*-----*/
           K     = HK(1);
           HK(1) = HK(2);
           HK(2) = K;
         END;
       ELSE
         IF HK(1) > HK(3) THEN DO;
           /*-----*/
           /* 231 */
           /*-----*/
           K     = HK(3);
           HK(3) = HK(2);
           HK(2) = HK(1);
           HK(1) = K;
         END;
         ELSE
           IF HK(2) > HK(3) THEN DO;
             /*-----*/
             /* 132 */
             /*-----*/
             K     = HK(2);
             HK(2) = HK(3);
             HK(3) = K;
           END;
           ELSE;
             /*-----*/
             /* 123 */
             /*-----*/

   /*-------------------*/
   /* Sort other pieces */
   /*-------------------*/

   IF NP_CNT > 4 THEN
     DO UNTIL (SORTED);
       SORTED = TRUE;
       DO J = 4 TO (NP_CNT - 1);
         IF HK(J) > HK(J+1) THEN DO;
           SORTED = FALSE;
           K       = HK(J);
           HK(J)   = HK(J+1);
           HK(J+1) = K;
         END;
       END;
     END;

   %IF DEBUG_UNSEEN = 'Y' %THEN %DO;
   PUT FILE (STATS) SKIP EDIT ('SRT ', HEX(HIST_KEY)) (2 A);
   %END;
   /*-------------------------------------------*/
   /* Search for configuration in history table */
   /*-------------------------------------------*/

   HIST_TBL_PTR = ADDR(HIST_TBL);

   DO J = 1 TO (NUMBER_PIECES_END + 2);
     IF HIST_NEXT_PTR(HK(J)) = SYSNULL THEN DO;
       HIST_TBL_CNT = HIST_TBL_CNT + 1;

       IF HIST_TBL_CNT > HBOUND(HIST_TBL) THEN DO;
         DISPLAY ('Number of history table entries exceeds maximum');
         DISPLAY ('Enlarge HIST_TBL to remedy');
         DISPLAY ('Terminating');
         STOP;
       END;

       HIST_NEXT_PTR(HK(J)) = ADDR(HIST_TBL(HIST_TBL_CNT));

       %IF DEBUG_UNSEEN = 'Y' %THEN %DO;
       PUT FILE (STATS) SKIP EDIT ('LINK') (A);
       PUT FILE (STATS) SKIP EDIT (HEX(HIST_TBL_PTR)) (A);
       PUT FILE (STATS) SKIP;
       DO K = 0 TO 25;
         PUT FILE (STATS) EDIT (HEX(HIST_NEXT_PTR(K))) (A(9));
       END;
       %END;
       HIST_TBL_PTR = ADDR(HIST_TBL(HIST_TBL_CNT));

       HIST_NEXT_PTR = SYSNULL;
     END;
     ELSE DO;

       %IF DEBUG_UNSEEN = 'Y' %THEN %DO;
       PUT FILE (STATS) SKIP EDIT ('LINK') (A);
       PUT FILE (STATS) SKIP EDIT (HEX(HIST_TBL_PTR)) (A);
       PUT FILE (STATS) SKIP;
       DO K = 0 TO 25;
         PUT FILE (STATS) EDIT (HEX(HIST_NEXT_PTR(K))) (A(9));
       END;
       %END;
       HIST_TBL_PTR = HIST_NEXT_PTR(HK(J));
     END;
   END;

   %IF DEBUG_UNSEEN = 'Y' %THEN %DO;
   PUT FILE (STATS) SKIP EDIT ('LAST') (A);
   PUT FILE (STATS) SKIP EDIT (HEX(HIST_TBL_PTR)) (A);
   PUT FILE (STATS) SKIP;
   DO K = 0 TO 25;
     PUT FILE (STATS) EDIT (HEX(HIST_NEXT_PTR(K))) (A(9));
   END;
   %END;
   /*-----------------------------*/
   /* If vacant, it doesn't exist */
   /*-----------------------------*/

   IF HIST_SEEN(HK(J)) = 0 THEN DO;

     /*----------------------------*/
     /* Add board to history table */
     /*----------------------------*/

     HIST_ENT_CNT = HIST_ENT_CNT + 1;

     %IF DEBUG_UNSEEN = 'Y' %THEN %DO;
     IF MOD(HIST_ENT_CNT,1000) = 0 THEN
       DISPLAY ('History Table Entries = ' || NUMSTR(HIST_ENT_CNT));
     %END;
     HIST_SEEN(HK(J)) = CONFIGURATIONS;

     %IF DEBUG_UNSEEN = 'Y' %THEN %DO;
     PUT FILE (STATS) SKIP EDIT ('NEW') (A);
     %END;
   END;
   ELSE
     IF HIST_SEEN(HK(J)) ^= CONFIGURATIONS THEN DO;

     /*------------------------------*/
     /* Existing board configuration */
     /*------------------------------*/

     ALREADY_SEEN = ALREADY_SEEN + 1;

     %IF DEBUG_UNSEEN = 'Y' %THEN %DO;
     PUT FILE (STATS) EDIT
       (' - Old (', HEX(SUBSTR(HIST_KEY,1,NP_CNT)), ')') (3 A);

     IF I > 1 THEN DO;
       %IF TYPE = 'HEX' %THEN %DO;
       PUT FILE (STATS) EDIT (' - Reflection') (A);
       %END;
       %ELSE %DO;
       PUT FILE (STATS) EDIT (' - Rotation or reflection') (A);
       %END;
     END;
     %END;
     RETURN (FALSE);
   END;
 END;

 RETURN (TRUE);

 END UNSEEN;

 WRAP_UP: PROC;

 IF REPORT_TITLE ^= '' THEN
   PUT FILE (STATS) EDIT (REPORT_TITLE, ' ') (SKIP, A);

 RUN_DATETIME = DATETIME;

 PUT FILE (STATS) EDIT
   ('CONFIG - Run on ',
    RUN.MM, '-', RUN.DD, '-', RUN.YYYY,
    ' at ',
    RUN.HH, ':', RUN.MI, ':', RUN.SS,
    ' ')
   (SKIP, 12 A, SKIP, A);

 PUT FILE (STATS) SKIP EDIT
   ('Letter pieces .................. ', NUMSTR(LETTER_PIECES)) (2 A);

 PUT FILE (STATS) SKIP EDIT
   ('Number pieces .................. ', NUMSTR(NUMBER_PIECES_END)) (2 A);

 IF MAX_CONFIGURATIONS ^= MAX_BIN THEN
   PUT FILE (STATS) SKIP EDIT
     ('Maximum configurations ......... ', NUMSTR(MAX_CONFIGURATIONS))
     (2 A);

 PUT FILE (STATS) EDIT
   ('Configurations checked ......... ', NUMSTR(CONFIGURATIONS),
    'Already seen ................... ', NUMSTR(ALREADY_SEEN),
    'Stranded configurations ........ ', NUMSTR(STRANDED),
    'No-move configurations ......... ', NUMSTR(NO_MOVES),
    'Configurations written ......... ', NUMSTR(WRITTEN))
  (SKIP, 2 A);

 END WRAP_UP;

 /*----------------------------------------*/
 /* Convert an integer to a numeric string */
 /*----------------------------------------*/

 DCL NUMSTR GENERIC (NUMSTR_8     WHEN (FIXED BIN (8) UNSIGNED),
                     NUMSTR_31    WHEN (FIXED BIN (31)),
                     NUMSTR_ERROR OTHERWISE);

 NUMSTR_8: PROC (NUM) RETURNS (CHAR (13) VARYING) REORDER;

 DCL NUM                      FIXED BIN (8) UNSIGNED;

 DCL I                        FIXED BIN (31) INIT (0);

 DCL CHR                      CHAR (3)  INIT ((3)' ');
 DCL PIC                      PIC 'ZZ9' BASED(ADDR(CHR));

 PIC = NUM;

 DO I = 1 TO 2 WHILE (SUBSTR(CHR,I,1) = ' ');
 END;

 RETURN (SUBSTR(CHR,I));

 END NUMSTR_8;

 NUMSTR_31: PROC (NUM) RETURNS (CHAR (13) VARYING) REORDER;

 DCL NUM                      FIXED BIN (31);

 DCL I                        FIXED BIN (31) INIT (0);

 DCL CHR                      CHAR (13)           INIT ((13)' ');
 DCL PIC                      PIC 'Z,ZZZ,ZZZ,ZZ9' BASED(ADDR(CHR));

 PIC = NUM;

 DO I = 1 TO 12 WHILE (SUBSTR(CHR,I,1) = ' ');
 END;

 RETURN (SUBSTR(CHR,I));

 END NUMSTR_31;

 NUMSTR_ERROR: PROC;

 DISPLAY ('NUMSTR received invalid value');

 STOP;

 END NUMSTR_ERROR;

 END CFG7X7;