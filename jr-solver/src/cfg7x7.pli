 CFG7X7: /* UFO SOLVER */

 /*--------------------------------------------------------*/
 /* GENERATE UFO CONFIGURATIONS                            */
 /*                                                        */
 /* Last Changed 14 FEB 2022                               */
 /*                                                        */
 /* by John Rausch, Bexley, Ohio, 2006, 2010, 2019 & 2022  */
 /*--------------------------------------------------------*/

 PROC (PARM_STRING) OPTIONS (MAIN, NOEXECOPS) REORDER;

 /*-------------------------------*/
 /* Generate Board Configurations */
 /*-------------------------------*/

 DEFAULT RANGE (*) STATIC;

 DCL MAX_BIN FIXED BIN (32) UNSIGNED VALUE (2147483647);

 DCL CONFIG_SIZE              FIXED BIN (31) VALUE (49);
 DCL CONFIG_CENTER            FIXED BIN (31) VALUE (25);

 DCL BOARD_SIZE               FIXED BIN (31) VALUE (77);
 DCL BOARD_CENTER             FIXED BIN (31) VALUE (44);
 DCL BOARD_BEGIN              FIXED BIN (31) VALUE (11);

 DCL PARM_STRING              CHAR (100) VARYING;

 DCL WORK                     CHAR (102) VARYING INIT ('');

 DCL PARM                     CHAR (100) VARYING INIT ('');
 DCL ARG                      CHAR (100) VARYING INIT ('');

 DCL REPORT_TITLE             CHAR (100) VARYING INIT ('');

 DCL DRIVE_AND_PATH           CHAR (80)  VARYING INIT ('');
 DCL FILE_PREFIX              CHAR (80)  VARYING INIT ('');
 DCL STATISTICS_FILE          CHAR (80)  VARYING INIT ('');
 DCL CONFIGURATIONS_FILE      CHAR (80)  VARYING INIT ('');

 DCL BOARD                    CHAR (BOARD_SIZE)  INIT ('');
 DCL B (BOARD_SIZE)           CHAR (1)   DEF BOARD;

 DCL CONFIG                   CHAR (CONFIG_SIZE) INIT ('');
 DCL C (CONFIG_SIZE)          CHAR (1)   DEF CONFIG;

 DCL I                        FIXED BIN (31) INIT (0);
 DCL X                        FIXED BIN (31) INIT (0);
 DCL Y                        FIXED BIN (31) INIT (0);
 DCL Z                        FIXED BIN (31) INIT (0);
 DCL N1                       FIXED BIN (31) INIT (0);
 DCL N2                       FIXED BIN (31) INIT (0);
 DCL N3                       FIXED BIN (31) INIT (0);
 DCL N4                       FIXED BIN (31) INIT (0);
 DCL N5                       FIXED BIN (31) INIT (0);
 DCL N6                       FIXED BIN (31) INIT (0);
 DCL N7                       FIXED BIN (31) INIT (0);
 DCL N8                       FIXED BIN (31) INIT (0);
 DCL N9                       FIXED BIN (31) INIT (0);

 DCL ARG_MIN                  FIXED BIN (31) INIT (0);
 DCL ARG_MAX                  FIXED BIN (31) INIT (0);

 DCL ALREADY_SEEN             FIXED BIN (31) INIT (0);
 DCL CONFIGURATIONS           FIXED BIN (31) INIT (0);
 DCL LETTER_PIECES            FIXED BIN (31) INIT (1);
 DCL LEVEL                    FIXED BIN (31) INIT (0);
 DCL MAX_CONFIGURATIONS       FIXED BIN (31) INIT (0);
 DCL NO_MOVES                 FIXED BIN (31) INIT (0);
 DCL NUMBER_PIECES_BEG        FIXED BIN (31) INIT (1);
 DCL NUMBER_PIECES_END        FIXED BIN (31) INIT (5);
 DCL STRANDED                 FIXED BIN (31) INIT (0);
 DCL WRITTEN                  FIXED BIN (31) INIT (0);

 DCL ROT_TABLE                CHAR (256) INIT ((256)'00'X);
 DCL ROT (0:255)              CHAR (1)   DEF ROT_TABLE;

 DCL REF_TABLE                CHAR (256) INIT ((256)'00'X);
 DCL REF (0:255)              CHAR (1)   DEF REF_TABLE;

 DCL 1 HIST_TBL (9_000_000)  CONTROLLED,
       2 NEXT_PTR (0:49)      PTR;

 DCL HIST_TBL_PTR             PTR INIT (SYSNULL);

 DCL HIST_NEXT_PTR (0:49)     PTR BASED (HIST_TBL_PTR);

 DCL HIST_SEEN     (0:49)     FIXED BIN (32) UNSIGNED BASED (HIST_TBL_PTR);

 DCL HIST_TBL_CNT             FIXED BIN (31) INIT (0);
 DCL HIST_ENT_CNT             FIXED BIN (31) INIT (0);

 DCL HIST_KEY                 CHAR (12) INIT ('');

 DCL HK (12)                  FIXED BIN (8) UNSIGNED BASED (ADDR(HIST_KEY));

 DCL HIST_KEY_TBL (8)         CHAR (12) INIT ((8)(''));

 DCL RUN_DATETIME             CHAR (17)  INIT ('');

 DCL 1 RUN DEF RUN_DATETIME,
       2 YYYY                 CHAR (4),
       2 MM                   CHAR (2),
       2 DD                   CHAR (2),
       2 HH                   CHAR (2),
       2 MI                   CHAR (2),
       2 SS                   CHAR (2),
       2 MS                   CHAR (3);

 DCL TRUE                     BIT (1) VALUE ('1'B);
 DCL FALSE                    BIT (1) VALUE ('0'B);

 DCL DEBUGGING                BIT (1) INIT (FALSE);
 DCL DFAULT_FILE_PRESENT      BIT (1) INIT (TRUE);
 DCL INVALID_PARAMETERS       BIT (1) INIT (FALSE);
 DCL SWITCH_SETTING           BIT (1) INIT (FALSE);

 DCL ADDR       BUILTIN;
 DCL COPY       BUILTIN;
 DCL DATETIME   BUILTIN;
 DCL HBOUND     BUILTIN;
 DCL HEX        BUILTIN;
 DCL INDEX      BUILTIN;
 DCL LENGTH     BUILTIN;
 DCL SUBSTR     BUILTIN;
 DCL SYSNULL    BUILTIN;
 DCL TRANSLATE  BUILTIN;
 DCL UPPERCASE  BUILTIN;
 DCL VERIFY     BUILTIN;

 DCL DFAULT   FILE STREAM INPUT;

 DCL CFGTXT   FILE RECORD OUTPUT;

 DCL STATS    FILE STREAM OUTPUT;

 DCL SYSPRINT FILE;

 /*----------------*/
 /* Initialization */
 /*----------------*/

 ALLOCATE HIST_TBL;

 HIST_TBL_CNT = 1;
 HIST_ENT_CNT = 0;

 HIST_TBL_PTR = ADDR(HIST_TBL);

 HIST_NEXT_PTR = SYSNULL;

 /*-----------------------------*/
 /* Load any default parameters */
 /*-----------------------------*/

 ON UNDEFINEDFILE (DFAULT) DFAULT_FILE_PRESENT = FALSE;

 OPEN FILE (DFAULT) TITLE('/DEFAULT.CONFIG.TXT');

 IF DFAULT_FILE_PRESENT THEN DO;
   GET FILE (DFAULT) EDIT (WORK) (L);

   CLOSE FILE (DFAULT);

   IF WORK ^= '' THEN
     WORK = WORK || ',';
 END;

 IF PARM_STRING ^= '' THEN
   WORK = WORK || PARM_STRING || ',';

 WORK = UPPERCASE(WORK);

 /*--------------------------*/
 /* Parse the parameter list */
 /*--------------------------*/

 DO WHILE (LENGTH(WORK) > 0);

   /*-----------------------*/
   /* Extract one parameter */
   /*-----------------------*/

   DO I = 1 TO LENGTH(WORK) UNTIL (SUBSTR(WORK,I,1) = ',');
   END;

   PARM = SUBSTR(WORK,1,I-1);

   IF I = LENGTH(WORK) THEN
     WORK = '';
   ELSE
     WORK = SUBSTR(WORK,I+1);

   /*-------------------------------*/
   /* Extract argument when present */
   /*-------------------------------*/

   DO I = 1 TO LENGTH(PARM) UNTIL (SUBSTR(PARM,I,1) = '(');
   END;

   IF I < LENGTH(PARM) THEN DO;
     ARG = SUBSTR(PARM,I+1);

     IF SUBSTR(ARG,LENGTH(ARG),1) = ')' THEN DO;
       ARG = SUBSTR(ARG,1,LENGTH(ARG)-1);
       PARM = SUBSTR(PARM,1,I-1);
     END;
   END;

   /*--------------------------------------------------*/
   /* Extract "NO" prefix and establish switch setting */
   /*--------------------------------------------------*/

   IF LENGTH(PARM) > 2 & SUBSTR(PARM,1,2) = 'NO' THEN DO;
     PARM = SUBSTR(PARM,3);
     SWITCH_SETTING = FALSE;
   END;
   ELSE
     SWITCH_SETTING = TRUE;

   /*-------------------------*/
   /* Deal with the parameter */
   /*-------------------------*/

   SELECT (PARM);
     WHEN ('?') DO;
       PUT EDIT
         ('D .......... Debug Mode <NO>',
          'RT(x) ...... Title For Printed Output <None',
          'DP(x) ...... Drive and Path <None>',
          'FP(x) ...... File Prefix <none>',
          'MAXC(n) .... Maximum Configurations <None>',
          'LP(n) ...... Letter Pieces <1>',
          'NP(n-n) .... Number Pieces <1-9>')
         (SKIP, A);
       RETURN;
     END;

     WHEN ('D')
       DEBUGGING = SWITCH_SETTING;

     WHEN ('RT')
       REPORT_TITLE = ARG;

     WHEN ('DP')
       DRIVE_AND_PATH = ARG || '\';

     WHEN ('FP')
       FILE_PREFIX = ARG || '.';

     WHEN ('MAXC')
       MAX_CONFIGURATIONS = NUMERIC_VALUE(ARG, 1, MAX_BIN);

     WHEN ('LP')
       LETTER_PIECES = NUMERIC_VALUE(ARG, 1, 3);

     WHEN ('NP') DO;
       CALL RANGE(ARG, 1, 9);

       NUMBER_PIECES_BEG = ARG_MIN;
       NUMBER_PIECES_END = ARG_MAX;
     END;

     OTHERWISE DO;
       DISPLAY ('Unknown parameter "' || PARM || '"');
       INVALID_PARAMETERS = TRUE;
     END;
   END;
 END;

 IF INVALID_PARAMETERS THEN DO;
   DISPLAY ('Invalid parameters - Terminating');
   STOP;
 END;

 /*----------------------------------------------*/
 /* Numeric value function for parameter parsing */
 /*----------------------------------------------*/

 NUMERIC_VALUE: PROC (ARG, MIN, MAX) RETURNS (FIXED BIN (31));

 DCL ARG                      CHAR (100) VARYING;

 DCL (MIN,MAX)                FIXED BIN (31);

 DCL VAL                      FIXED BIN (31) INIT (0);

 IF VERIFY(ARG, '0123456789') = 0 THEN DO;
   VAL = ARG;

   IF VAL < MIN THEN DO;
     DISPLAY ('Value for "' || PARM || '" < ' || NUMSTR(MIN));
     INVALID_PARAMETERS = TRUE;
     RETURN (0);
   END;
   ELSE
     IF VAL > MAX THEN DO;
       DISPLAY ('Value for "' || PARM || '" > ' || NUMSTR(MAX));
       INVALID_PARAMETERS = TRUE;
       RETURN (0);
     END;
     ELSE
       RETURN (VAL);
 END;
 ELSE DO;
   DISPLAY ('Invalid value for "' || PARM || '"');
   INVALID_PARAMETERS = TRUE;
 END;

 END NUMERIC_VALUE;

 /*----------------------------------------*/
 /* Range subroutine for parameter parsing */
 /*----------------------------------------*/

 RANGE: PROC (ARG, MIN, MAX);

 DCL ARG                      CHAR (100) VARYING;

 DCL WRK                      CHAR (100) VARYING;

 DCL (MIN,MAX)                FIXED BIN (31);

 DCL I                        FIXED BIN (31) INIT (0);

 I = INDEX(ARG,'-');

 IF I = 0 THEN DO;
   IF ARG = 'N' THEN
     ARG_MIN, ARG_MAX = MAX;
   ELSE
     ARG_MIN, ARG_MAX = NUMERIC_VALUE(ARG, MIN, MAX);
 END;
 ELSE DO;
   WRK = SUBSTR(ARG,1,I-1);

   IF WRK = 'N' THEN
     ARG_MIN = MIN;
   ELSE
     ARG_MIN = NUMERIC_VALUE(WRK, MIN, MAX);

   WRK = SUBSTR(ARG,I+1);

   IF WRK = 'N' THEN
     ARG_MAX = MAX;
   ELSE
     ARG_MAX = NUMERIC_VALUE(WRK, MIN, MAX);
 END;

 IF ^ INVALID_PARAMETERS & ARG_MAX < ARG_MIN THEN DO;
   DISPLAY ('Invalid range for "' || PARM || '"');
   INVALID_PARAMETERS = TRUE;
 END;

 RETURN;

 END RANGE;

 IF MAX_CONFIGURATIONS = 0 THEN
   MAX_CONFIGURATIONS = MAX_BIN;

 /*--------------------------------------------------------------*/
 /* The top number is the subscript for the board array, the 2nd */
 /* is for the string representaion position, and the 3rd is the */
 /* hex value for the 2nd.                                       */
 /*--------------------------------------------------------------*/

 /*--------------------------------------*/
 /* +----+----+----+----+----+----+----+ */
 /* | 11 | 12 | 13 | 14 | 15 | 16 | 17 | */
 /* | 01 | 02 | 03 | 04 | 05 | 06 | 07 | */
 /* | 01 | 02 | 03 | 04 | 05 | 06 | 07 | */
 /* +----+----+----+----+----+----+----+ */
 /* | 21 | 22 | 23 | 24 | 25 | 26 | 27 | */
 /* | 08 | 09 | 10 | 11 | 12 | 13 | 14 | */
 /* | 08 | 09 | 0A | 0B | 0C | 0D | 0E | */
 /* +----+----+----+----+----+----+----+ */
 /* | 31 | 32 | 33 | 34 | 35 | 36 | 37 | */
 /* | 15 | 16 | 17 | 18 | 19 | 20 | 21 | */
 /* | 0F | 10 | 11 | 12 | 13 | 14 | 15 | */
 /* +----+----+----+----+----+----+----+ */
 /* | 41 | 42 | 43 | 44 | 45 | 46 | 47 | */
 /* | 22 | 23 | 24 | 25 | 26 | 27 | 28 | */
 /* | 16 | 17 | 18 | 19 | 1A | 1B | 1C | */
 /* +----+----+----+----+----+----+----+ */
 /* | 51 | 52 | 53 | 54 | 55 | 56 | 57 | */
 /* | 29 | 30 | 31 | 32 | 33 | 34 | 35 | */
 /* | 1D | 1E | 1F | 20 | 21 | 22 | 23 | */
 /* +----+----+----+----+----+----+----+ */
 /* | 58 | 59 | 60 | 61 | 62 | 63 | 64 | */
 /* | 36 | 37 | 38 | 39 | 40 | 41 | 42 | */
 /* | 24 | 25 | 26 | 27 | 28 | 29 | 2A | */
 /* +----+----+----+----+----+----+----+ */
 /* | 65 | 66 | 67 | 68 | 69 | 70 | 71 | */
 /* | 43 | 44 | 45 | 46 | 47 | 48 | 49 | */
 /* | 2B | 2C | 2D | 2E | 2F | 30 | 31 | */
 /* +----+----+----+----+----+----+----+ */
 /*--------------------------------------*/

 /*------------------------------*/
 /* Translate table for rotation */
 /*------------------------------*/

 ROT(01) = '2B'X;
 ROT(02) = '24'X;
 ROT(03) = '1D'X;
 ROT(04) = '16'X;
 ROT(05) = '0F'X;
 ROT(06) = '08'X;
 ROT(07) = '01'X;

 ROT(08) = '2C'X;
 ROT(09) = '25'X;
 ROT(10) = '1E'X;
 ROT(11) = '17'X;
 ROT(12) = '10'X;
 ROT(13) = '09'X;
 ROT(14) = '02'X;

 ROT(15) = '2D'X;
 ROT(16) = '26'X;
 ROT(17) = '1F'X;
 ROT(18) = '18'X;
 ROT(19) = '11'X;
 ROT(20) = '0A'X;
 ROT(21) = '03'X;

 ROT(22) = '2E'X;
 ROT(23) = '27'X;
 ROT(24) = '20'X;
 ROT(25) = '19'X;
 ROT(26) = '12'X;
 ROT(27) = '0B'X;
 ROT(28) = '04'X;

 ROT(29) = '2F'X;
 ROT(30) = '28'X;
 ROT(31) = '21'X;
 ROT(32) = '1A'X;
 ROT(33) = '13'X;
 ROT(34) = '0C'X;
 ROT(35) = '05'X;

 ROT(36) = '30'X;
 ROT(37) = '29'X;
 ROT(38) = '22'X;
 ROT(39) = '1B'X;
 ROT(40) = '14'X;
 ROT(41) = '0D'X;
 ROT(42) = '06'X;

 ROT(43) = '31'X;
 ROT(44) = '2A'X;
 ROT(45) = '23'X;
 ROT(46) = '1C'X;
 ROT(47) = '15'X;
 ROT(48) = '0E'X;
 ROT(49) = '07'X;

 /*--------------------------------*/
 /* Translate table for reflection */
 /*--------------------------------*/

 REF(01) = '2B'X;
 REF(02) = '2C'X;
 REF(03) = '2D'X;
 REF(04) = '2E'X;
 REF(05) = '2F'X;
 REF(06) = '30'X;
 REF(07) = '31'X;

 REF(08) = '24'X;
 REF(09) = '25'X;
 REF(10) = '26'X;
 REF(11) = '27'X;
 REF(12) = '28'X;
 REF(13) = '29'X;
 REF(14) = '2A'X;

 REF(15) = '1D'X;
 REF(16) = '1E'X;
 REF(17) = '1F'X;
 REF(18) = '20'X;
 REF(19) = '21'X;
 REF(20) = '22'X;
 REF(21) = '23'X;

 ROT(22) = '16'X;
 ROT(23) = '17'X;
 ROT(24) = '18'X;
 ROT(25) = '19'X;
 ROT(26) = '1A'X;
 ROT(27) = '1B'X;
 ROT(28) = '1C'X;

 ROT(29) = '0F'X;
 ROT(30) = '10'X;
 ROT(31) = '11'X;
 ROT(32) = '12'X;
 ROT(33) = '13'X;
 ROT(34) = '14'X;
 ROT(35) = '15'X;

 ROT(36) = '08'X;
 ROT(37) = '09'X;
 ROT(38) = '0A'X;
 ROT(39) = '0B'X;
 ROT(40) = '0C'X;
 ROT(41) = '0D'X;
 ROT(42) = '0E'X;

 ROT(43) = '01'X;
 ROT(44) = '02'X;
 ROT(45) = '03'X;
 ROT(46) = '04'X;
 ROT(47) = '05'X;
 ROT(48) = '06'X;
 ROT(49) = '07'X;

 CONFIGURATIONS_FILE = DRIVE_AND_PATH || FILE_PREFIX || 'CONFIGURATIONS';
 STATISTICS_FILE     = DRIVE_AND_PATH || FILE_PREFIX || 'CONFIGURATIONS.STATISTICS';

 OPEN FILE (CFGTXT)TITLE ('/' || CONFIGURATIONS_FILE || '.TXT,APPEND(N)');
 OPEN FILE (STATS) TITLE ('/' || STATISTICS_FILE     || '.TXT,APPEND(N)');

 CONFIG = COPY('-', CONFIG_SIZE);

 DO X = 1, 2, 3, 7, 8;
   C(X) = 'X';

   IF LETTER_PIECES = 1 THEN
     CALL LETTER_PIECES_1;
   ELSE
     IF LETTER_PIECES = 2 THEN
       CALL LETTER_PIECES_2;
     ELSE
       CALL LETTER_PIECES_3;

   C(X) = '-';

   Y, Z, N1, N2, N3, N4, N5, N6, N7, N8, N9 = 0;
 END;

 /*----------------*/
 /* 1 Letter Piece */
 /*----------------*/

 LETTER_PIECES_1: PROC;

 LEVEL = 1;

 IF NUMBER_PIECES_BEG <=1 THEN
   DO N1 = 1 TO CONFIG_SIZE;
   IF C(N1) ^= '-' THEN GO TO LP1_LVL1_N1;
   C(N1) = '1';
   CALL CHECK_CONFIG;
   C(N1) = '-'; LP1_LVL1_N1: END;

 LEVEL = 2;

 IF NUMBER_PIECES_BEG <= 2 & NUMBER_PIECES_END >= 2 THEN
   DO N1 = 1 TO CONFIG_SIZE;
   IF C(N1) ^= '-' THEN GO TO LP1_LVL2_N1;
   C(N1) = '1';
   DO N2 = (N1 + 1) TO CONFIG_SIZE;
   IF C(N2) ^= '-' THEN GO TO LP1_LVL2_N2;
   C(N2) = '2';
   CALL CHECK_CONFIG;
   C(N2) = '-'; LP1_LVL2_N2: END;
   C(N1) = '-'; LP1_LVL2_N1: END;

 LEVEL = 3;

 IF NUMBER_PIECES_BEG <= 3 & NUMBER_PIECES_END >= 3 THEN
   DO N1 = 1 TO CONFIG_SIZE;
   IF C(N1) ^= '-' THEN GO TO LP1_LVL3_N1;
   C(N1) = '1';
   DO N2 = (N1 + 1) TO CONFIG_SIZE;
   IF C(N2) ^= '-' THEN GO TO LP1_LVL3_N2;
   C(N2) = '2';
   DO N3 = (N2 + 1) TO CONFIG_SIZE;
   IF C(N3) ^= '-' THEN GO TO LP1_LVL3_N3;
   C(N3) = '3';
   CALL CHECK_CONFIG;
   C(N3) = '-'; LP1_LVL3_N3: END;
   C(N2) = '-'; LP1_LVL3_N2: END;
   C(N1) = '-'; LP1_LVL3_N1: END;

 LEVEL = 4;

 IF NUMBER_PIECES_BEG <= 4 & NUMBER_PIECES_END >= 4 THEN
   DO N1 = 1 TO CONFIG_SIZE;
   IF C(N1) ^= '-' THEN GO TO LP1_LVL4_N1;
   C(N1) = '1';
   DO N2 = (N1 + 1) TO CONFIG_SIZE;
   IF C(N2) ^= '-' THEN GO TO LP1_LVL4_N2;
   C(N2) = '2';
   DO N3 = (N2 + 1) TO CONFIG_SIZE;
   IF C(N3) ^= '-' THEN GO TO LP1_LVL4_N3;
   C(N3) = '3';
   DO N4 = (N3 + 1) TO CONFIG_SIZE;
   IF C(N4) ^= '-' THEN GO TO LP1_LVL4_N4;
   C(N4) = '4';
   CALL CHECK_CONFIG;
   C(N4) = '-'; LP1_LVL4_N4: END;
   C(N3) = '-'; LP1_LVL4_N3: END;
   C(N2) = '-'; LP1_LVL4_N2: END;
   C(N1) = '-'; LP1_LVL4_N1: END;

 LEVEL = 5;

 IF NUMBER_PIECES_END <= 5 & NUMBER_PIECES_END >= 5 THEN
   DO N1 = 1 TO CONFIG_SIZE;
   IF C(N1) ^= '-' THEN GO TO LP1_LVL5_N1;
   C(N1) = '1';
   DO N2 = (N1 + 1) TO CONFIG_SIZE;
   IF C(N2) ^= '-' THEN GO TO LP1_LVL5_N2;
   C(N2) = '2';
   DO N3 = (N2 + 1) TO CONFIG_SIZE;
   IF C(N3) ^= '-' THEN GO TO LP1_LVL5_N3;
   C(N3) = '3';
   DO N4 = (N3 + 1) TO CONFIG_SIZE;
   IF C(N4) ^= '-' THEN GO TO LP1_LVL5_N4;
   C(N4) = '4';
   DO N5 = (N4 + 1) TO CONFIG_SIZE;
   IF C(N5) ^= '-' THEN GO TO LP1_LVL5_N5;
   C(N5) = '5';
   CALL CHECK_CONFIG;
   C(N5) = '-'; LP1_LVL5_N5: END;
   C(N4) = '-'; LP1_LVL5_N4: END;
   C(N3) = '-'; LP1_LVL5_N3: END;
   C(N2) = '-'; LP1_LVL5_N2: END;
   C(N1) = '-'; LP1_LVL5_N1: END;

 LEVEL = 6;

 IF NUMBER_PIECES_BEG <= 6 & NUMBER_PIECES_END >= 6 THEN
   DO N1 = 1 TO CONFIG_SIZE;
   IF C(N1) ^= '-' THEN GO TO LVL6_N1;
   C(N1) = '1';
   DO N2 = (N1 + 1) TO CONFIG_SIZE;
   IF C(N2) ^= '-' THEN GO TO LVL6_N2;
   C(N2) = '2';
   DO N3 = (N2 + 1) TO CONFIG_SIZE;
   IF C(N3) ^= '-' THEN GO TO LVL6_N3;
   C(N3) = '3';
   DO N4 = (N3 + 1) TO CONFIG_SIZE;
   IF C(N4) ^= '-' THEN GO TO LVL6_N4;
   C(N4) = '4';
   DO N5 = (N4 + 1) TO CONFIG_SIZE;
   IF C(N5) ^= '-' THEN GO TO LVL6_N5;
   C(N5) = '5';
   DO N6 = (N5 + 1) TO CONFIG_SIZE;
   IF C(N6) ^= '-' THEN GO TO LVL6_N6;
   C(N6) = '6';
   CALL CHECK_CONFIG;
   C(N6) = '-'; LVL6_N6: END;
   C(N5) = '-'; LVL6_N5: END;
   C(N4) = '-'; LVL6_N4: END;
   C(N3) = '-'; LVL6_N3: END;
   C(N2) = '-'; LVL6_N2: END;
   C(N1) = '-'; LVL6_N1: END;

 LEVEL = 7;

 IF NUMBER_PIECES_BEG <= 7 & NUMBER_PIECES_END >= 7 THEN
   DO N1 = 1 TO CONFIG_SIZE;
   IF C(N1) ^= '-' THEN GO TO LVL7_N1;
   C(N1) = '1';
   DO N2 = (N1 + 1) TO CONFIG_SIZE;
   IF C(N2) ^= '-' THEN GO TO LVL7_N2;
   C(N2) = '2';
   DO N3 = (N2 + 1) TO CONFIG_SIZE;
   IF C(N3) ^= '-' THEN GO TO LVL7_N3;
   C(N3) = '3';
   DO N4 = (N3 + 1) TO CONFIG_SIZE;
   IF C(N4) ^= '-' THEN GO TO LVL7_N4;
   C(N4) = '4';
   DO N5 = (N4 + 1) TO CONFIG_SIZE;
   IF C(N5) ^= '-' THEN GO TO LVL7_N5;
   C(N5) = '5';
   DO N6 = (N5 + 1) TO CONFIG_SIZE;
   IF C(N6) ^= '-' THEN GO TO LVL7_N6;
   C(N6) = '6';
   DO N7 = (N6 + 1) TO CONFIG_SIZE;
   IF C(N7) ^= '-' THEN GO TO LVL7_N7;
   C(N7) = '7';
   CALL CHECK_CONFIG;
   C(N7) = '-'; LVL7_N7: END;
   C(N6) = '-'; LVL7_N6: END;
   C(N5) = '-'; LVL7_N5: END;
